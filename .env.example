# Server Configuration
PORT=8888
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/gtm_game
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gtm_game
DATABASE_USER=username
DATABASE_PASSWORD=password

# Gmail OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8888/auth/google/callback
JWT_SECRET=your-super-secret-jwt-key-here

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Monetization Configuration
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Application Configuration
APP_NAME=Guess The Movie Game
APP_URL=http://localhost:8888
API_VERSION=v1

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security Configuration
CORS_ORIGIN=http://localhost:8888
SESSION_SECRET=your-session-secret-here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_AUTHENTICATION=true
ENABLE_MONETIZATION=false
ENABLE_ANALYTICS=true
ENABLE_SOCIAL_FEATURES=false

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif

# External Services
TMDB_API_KEY=your-tmdb-api-key
EMAIL_SERVICE_API_KEY=your-email-service-key
