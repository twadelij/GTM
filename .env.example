# Server Configuration
PORT=8888
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://gtm_user:gtm_password@postgres:5432/gtm_game
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=gtm_game
DATABASE_USER=gtm_user
DATABASE_PASSWORD=gtm_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# Application Configuration
APP_NAME=Weekly GTM League
APP_URL=http://localhost:8888
API_VERSION=v1

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security Configuration
CORS_ORIGIN=http://localhost:8888
SESSION_SECRET=your-session-secret-here

# Feature Flags
ENABLE_AUTHENTICATION=true
ENABLE_MONETIZATION=false
ENABLE_ANALYTICS=false
ENABLE_SOCIAL_FEATURES=true

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif

# External Services
# Get TMDB API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Active Directory Configuration (CBS AD)
AD_SERVER=ldap://cbsp.nl
AD_BASE_DN=dc=cbsp,dc=nl
AD_BIND_USER=sa_ansible
AD_BIND_PASSWORD=your-sa_ansible-password
